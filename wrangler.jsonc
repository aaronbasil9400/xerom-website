{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xerom-website",
  "compatibility_date": "2026-09-09",
  "vars": {
    "BOOKING_MODE": "live",
    "ACCESS_TEAM_DOMAIN": "https://icy-wave-7d2a.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "9acdb8ad52c585899202e9be7c345ebabe51bf37f79c33f2b31f3afac09d5bc8",
    "TURNSTILE_EXPECTED_HOSTNAME": "xerom-website.xerombookings.workers.dev"
  },
  "ratelimits": [
    { "name": "PUBLIC_AVAILABILITY_RATE_LIMIT", "namespace_id": "101001", "simple": { "limit": 120, "period": 60 } },
    { "name": "PUBLIC_BOOKING_RATE_LIMIT", "namespace_id": "101002", "simple": { "limit": 10, "period": 60 } },
    { "name": "OWNER_READ_RATE_LIMIT", "namespace_id": "101003", "simple": { "limit": 60, "period": 60 } },
    { "name": "OWNER_MUTATION_RATE_LIMIT", "namespace_id": "101004", "simple": { "limit": 60, "period": 60 } },
    { "name": "OWNER_UPLOAD_RATE_LIMIT", "namespace_id": "101005", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator",
        "script_name": "xerom-race-control-coordinator"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "RACE_CONTROL_CONFIG_BUCKET",
      "bucket_name": "xerom-race-control-config"
    },
    {
      "binding": "RACE_CONTROL_MEDIA_BUCKET",
      "bucket_name": "xerom-race-control-media"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
