---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { business } from "@/config/business";
---
<BaseLayout title="Events | Xerom SimRacing & Cafe" description="Find Xerom event announcements on Instagram.">
  <section class="page-hero section-shell">
    <h1 class="display">Events at <span class="red">Xerom</span></h1>
    <p class="lede">Event announcements and details are shared on Instagram for now. A site announcement feature is planned.</p>
    <a class="button button-primary" href={business.instagramUrl}>See Xerom on Instagram</a>
  </section>
</BaseLayout>
