---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { business } from "@/config/business";
---
<BaseLayout title="What’s New | Xerom SimRacing & Cafe" description="Find the latest Xerom announcements on Instagram.">
  <section class="page-hero section-shell">
    <h1 class="display">What’s <span class="red">new</span></h1>
    <p class="lede">Xerom shares current announcements on Instagram. A dedicated website updates feature will be added later.</p>
    <a class="button button-primary" href={business.instagramUrl}>Follow @{business.instagramHandle}</a>
  </section>
</BaseLayout>
