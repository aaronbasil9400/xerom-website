---
import RaceControlLayout from '../../layouts/RaceControlLayout.astro';
import Agenda from '../../components/race-control/Agenda.astro';
import BookingInspector from '../../components/race-control/BookingInspector.astro';
import BookingCreateForm from '../../components/race-control/BookingCreateForm.astro';
import { env as cloudflareEnv } from "cloudflare:workers";
import { resolveRuntimeConfig } from "@/lib/config/runtime";
import BlockTimeForm from '../../components/race-control/BlockTimeForm.astro';

const { config } = await resolveRuntimeConfig(cloudflareEnv);
const malaysiaToday = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Kuala_Lumpur', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date());
const runtimeEnv = cloudflareEnv as typeof cloudflareEnv & CloudflareEnv;
const liveEnabled = Boolean(runtimeEnv.GOOGLE_SERVICE_ACCOUNT_EMAIL && runtimeEnv.GOOGLE_PRIVATE_KEY && runtimeEnv.BOOKING_COORDINATOR);
---
<RaceControlLayout title="Schedule" section="schedule">
  <div class="rc-toolbar" aria-label="Schedule controls">
    <div class="rc-toolbar-group">
      <button type="button" data-rc-date-nav="previous">Previous</button><button type="button" data-rc-date-nav="today">Today</button><button type="button" data-rc-date-nav="next">Next</button>
      <label><span>Date</span><input data-rc-business-date data-rc-today={malaysiaToday} type="date" value={malaysiaToday} /></label>
    </div>
    <div class="rc-toolbar-group">
      <button type="button" class="active" disabled>Day</button><button type="button" disabled>Agenda</button>
      <label><span>Service</span><select data-rc-service-filter disabled={!liveEnabled}><option value="all">All services</option><option value="regular-sim">Regular Sim</option><option value="pro-sim">Pro Sim</option><option value="ps5">PS5</option></select></label>
      <label class="rc-toolbar-search"><span>Search</span><input data-rc-schedule-search type="search" placeholder={liveEnabled ? 'Booking, resource or status' : 'Search coming next'} disabled={!liveEnabled} /></label>
    </div>
    <div class="rc-toolbar-actions"><a class="rc-button" href="#block-time">Block time</a><a class="rc-button rc-button-primary" href="#new-booking">New booking</a></div>
  </div>
  <div class="rc-schedule-grid"><Agenda liveEnabled={liveEnabled} businessDate={malaysiaToday} /><BookingInspector live={liveEnabled} /></div>
  <BookingCreateForm config={config} />
  <BlockTimeForm config={config} />
</RaceControlLayout>
