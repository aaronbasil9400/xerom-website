---
import RaceControlLayout from '../../layouts/RaceControlLayout.astro'; import DemoNotice from '../../components/race-control/DemoNotice.astro';
---
<RaceControlLayout title="Website Content" section="content"><DemoNotice /><section class="rc-panel rc-editor"><div class="rc-panel-head"><h2>Public website sections · structured draft</h2><span class="rc-draft-pill">Owner review required</span></div><div class="rc-form-grid"><label>Venue headline<input placeholder="TODO(owner): approved headline" /></label><label>Contact / WhatsApp<input placeholder="TODO(owner): confirm display format" /></label><label class="rc-wide">About the venue<textarea placeholder="TODO(owner): approved copy only"></textarea></label></div><p class="rc-helper">Fixed sections and approved media only. Arbitrary HTML and unverified claims are not supported.</p><div class="rc-form-actions"><button class="rc-button" type="button">Save draft</button><button class="rc-button rc-button-primary" type="button">Review publication</button></div></section></RaceControlLayout>
