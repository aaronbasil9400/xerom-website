---
import RaceControlLayout from '../../../layouts/RaceControlLayout.astro'; import DemoNotice from '../../../components/race-control/DemoNotice.astro';
const slug = Astro.params.setting ?? 'resources'; const titles: Record<string,string> = { resources:'Resources', hours:'Hours & Closures', pricing:'Pricing', offers:'Offers & Packages', rules:'Advanced Rules' }; const title = titles[slug] ?? 'Business settings';
const active = slug === 'hours' ? 'hours' : slug === 'pricing' ? 'pricing' : slug === 'offers' ? 'offers' : slug === 'rules' ? 'rules' : 'resources';
---
<RaceControlLayout title={title} section={active}><DemoNotice /><section class="rc-panel rc-editor"><div class="rc-panel-head"><div><p class="rc-eyebrow">Business settings · draft</p><h2>{title} editor</h2></div><span class="rc-draft-pill">Not published</span></div><div class="rc-form-grid"><label>Display name<input value={title} /></label><label>Revision note<input placeholder="TODO(owner): describe this draft" /></label><label class="rc-wide">Owner value<textarea placeholder="TODO(owner): enter confirmed values before publishing"></textarea></label></div><div class="rc-form-actions"><button class="rc-button" type="button">Save draft</button><button class="rc-button rc-button-primary" type="button">Review changes</button></div></section><section class="rc-panel rc-empty"><h2>Impact review</h2><p>Publishing remains gated until owner values, authentication, validation, and affected-booking review are available.</p></section></RaceControlLayout>
