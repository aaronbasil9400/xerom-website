---
import RaceControlLayout from '../../../layouts/RaceControlLayout.astro'; import DemoNotice from '../../../components/race-control/DemoNotice.astro'; import BusinessSettingsEditor from '../../../components/race-control/BusinessSettingsEditor.astro';
const slug = Astro.params.setting ?? 'resources'; const titles: Record<string,string> = { resources:'Experience', hours:'Hours & Closures', pricing:'Pricing', offers:'Offers & Packages', rules:'Advanced Rules' }; const title = titles[slug] ?? 'Business settings';
const active = slug === 'hours' ? 'hours' : slug === 'pricing' ? 'pricing' : slug === 'offers' ? 'offers' : slug === 'rules' ? 'rules' : 'resources';
---
<RaceControlLayout title={title} section={active}><DemoNotice /><BusinessSettingsEditor setting={active} title={title} /></RaceControlLayout>
