---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BookingApp from "@/components/BookingApp.astro";
---
<BaseLayout title="Book a Session | Xerom SimRacing & Cafe" description="Check availability and book Regular Sim, Pro Sim or a PS5 lounge at Xerom in Klang.">
