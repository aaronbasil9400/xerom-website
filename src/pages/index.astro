---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExperienceDock from "@/components/home/ExperienceDock.astro";
import SessionCard from "@/components/home/SessionCard.astro";
import { services } from "@/config/services";
import { formatMoney } from "@/config/pricing";
import { media } from "@/config/media";
import { Image } from "astro:assets";
import ArrowIcon from "@/components/ArrowIcon.astro";
import "@/styles/home.css";
import { env as cloudflareEnv } from "cloudflare:workers";
import { resolveRuntimeConfig } from "@/lib/config/runtime";

let publishedHeroAssetId: string | null = null;
const { config: runtimeConfig } = await resolveRuntimeConfig(cloudflareEnv);
try {
  const candidate = runtimeConfig.websiteContent.homepage.heroAssetId;
  if (candidate?.startsWith("hero-")) publishedHeroAssetId = candidate;
} catch {
  // Compiled placeholder remains the explicit fallback until R2 is activated and a draft is published.
}
const runtimeService = Object.fromEntries(runtimeConfig.services.map((service) => [service.serviceId, service]));
const runtimeRate = (serviceId: "regular-sim" | "pro-sim" | "ps5") => (runtimeConfig.rates.find((rate) => rate.serviceId === serviceId && Date.parse(rate.effectiveFrom) <= Date.now() && (!rate.effectiveUntil || Date.now() < Date.parse(rate.effectiveUntil)))?.amountSenPerResourceHour ?? 0) / 100;
const dayLabels = { monday: "Mon", tuesday: "Tue", wednesday: "Wed", thursday: "Thu", friday: "Fri", saturday: "Sat", sunday: "Sun" } as const;
const clock = (value: string) => new Intl.DateTimeFormat("en-MY", { hour: "numeric", minute: "2-digit", timeZone: "Asia/Kuala_Lumpur" }).format(new Date(`2026-01-01T${value}:00+08:00`));
const runtimeHours = Object.entries(runtimeConfig.hours.weekly).map(([day, intervals]) => ({ days: dayLabels[day as keyof typeof dayLabels], hours: intervals.length ? intervals.map((interval) => `${clock(interval.open)}–${clock(interval.close)}`).join(", ") : "Closed" }));
const activeCount = (serviceId: "regular-sim" | "pro-sim" | "ps5") => runtimeConfig.resources.filter((resource) => resource.serviceId === serviceId && resource.lifecycle === "active").length;
const headlineWords = runtimeConfig.websiteContent.homepage.headline.split(/\s+/);
---

<BaseLayout runtimeConfig={runtimeConfig}>
  <div class="homepage">
    <div class="home-flow">
      <section class="home-hero" aria-labelledby="hero-title" data-home-hero>
        <div class="home-hero-media">
          {publishedHeroAssetId ? <img class="home-hero-image hero-image" src={`/api/media/${publishedHeroAssetId}`} alt="" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" /> : <picture>
            <source type="image/avif" srcset={`${media.heroSources.heroAvif640.src} 640w, ${media.heroSources.heroAvif960.src} 960w, ${media.heroSources.heroAvif1600.src} 1600w`} sizes="(max-width: 900px) 100vw, 88rem" />
            <source type="image/webp" srcset={`${media.heroSources.heroWebp640.src} 640w, ${media.heroSources.heroWebp960.src} 960w, ${media.heroSources.heroWebp1600.src} 1600w`} sizes="(max-width: 900px) 100vw, 88rem" />
            <img class="home-hero-image hero-image" src={media.hero.src} alt="Illustrative placeholder showing friends enjoying sim racing; replace with approved Xerom photography" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
          </picture>}
        </div>
        <div class="home-hero-copy">
          <p class="home-eyebrow">Sim Racing · PS5 · Cafe</p>
          <h1 id="hero-title"><span>{headlineWords.slice(0, -1).join(" ")}</span>{" "}<span class="red">{headlineWords.at(-1)}</span></h1>
          <p class="home-hero-tagline">Drive. Compete. Chill. Repeat.</p>
          <p class="home-hero-description">{runtimeConfig.websiteContent.homepage.intro}</p>
          <div class="home-hero-actions">
            <a class="button button-primary" href="/book">Book a session <ArrowIcon /></a>
            <a class="button button-secondary" href="#sessions">See pricing</a>
          </div>
          <a class="home-location-cue" href={runtimeConfig.websiteContent.venue.mapsUrl}>Bandar Bukit Tinggi, Klang</a>
        </div>
        {!publishedHeroAssetId && <p class="hero-placeholder-label">Illustrative hero · final owner photo pending</p>}
      </section>

      <ExperienceDock />

      <section class="home-section home-session-section" id="sessions" aria-labelledby="sessions-title">
        <div class="home-section-heading">
          <div>
            <p class="home-kicker">Our sessions</p>
            <h2 id="sessions-title">Pick your <span class="red">pace</span></h2>
            <p>From casual laps to focused race simulation.</p>
          </div>
          <div class="hours-chip" aria-label="Opening hours">
            <strong>Opening hours</strong>
            {runtimeHours.map((group) => <span><b>{group.days}</b> {group.hours}</span>)}
          </div>
        </div>
        <div class="home-session-grid">
          <SessionCard title={runtimeService["pro-sim"].name} copy={runtimeService["pro-sim"].description} image={media.proRigSmall} alt={services["pro-sim"].imageAlt} price={formatMoney(runtimeRate("pro-sim"))} href="/book?service=pro-sim" featured />
          <SessionCard title={runtimeService["regular-sim"].name} copy={runtimeService["regular-sim"].description} image={media.regularRigSmall} alt={services["regular-sim"].imageAlt} price={formatMoney(runtimeRate("regular-sim"))} href="/book?service=regular-sim" />
          <SessionCard title={runtimeService.ps5.name} copy={runtimeService.ps5.description} image={media.ps5LoungeSmall} alt={services.ps5.imageAlt} price={formatMoney(runtimeRate("ps5"))} href="/book?service=ps5" />
          <SessionCard title="Cafe" copy="A place to pause between sessions and spend more of the night together." image={media.cafeSmall} alt="Three colourful drinks from the Xerom cafe" href="/experiences#cafe" />
        </div>
      </section>
    </div>

    <section class="section-shell section-space split-section" id="about" aria-labelledby="setup-title">
      <div class="hardware-frame">
        <Image src={media.proRig} alt="Close-up of the Porsche-branded wheel centre on Xerom’s Pro Rig" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" loading="lazy" />
      </div>
      <div>
        <h2 class="section-title" id="setup-title">Choose your <span class="red">setup</span></h2>
        <p class="lede">Step into the dedicated Pro Rig, start with the accessible Regular Rig, or settle into a PS5 lounge. Choose a session from 30 minutes to two hours.</p>
        <ul class="feature-list">
          <li><span>{activeCount("pro-sim")} Pro rig{activeCount("pro-sim") === 1 ? "" : "s"} configured</span></li>
          <li><span>{activeCount("regular-sim")} Regular rig{activeCount("regular-sim") === 1 ? "" : "s"} configured</span></li>
          <li><span>{activeCount("ps5")} PS5 lounge{activeCount("ps5") === 1 ? "" : "s"} with {runtimeConfig.controllers.includedQuantity} controllers included per lounge</span></li>
        </ul>
        <a class="button button-secondary" href="/experiences">Compare experiences</a>
      </div>
    </section>

    <section class="home-visit-section" aria-label="Opening hours and location">
      <div class="home-visit-inner">
        <article class="home-info-card">
          <h2>Opening hours</h2>
          <dl class="home-hours-list">
            {runtimeHours.map((group) => <div><dt>{group.days}</dt><dd>{group.hours}</dd></div>)}
          </dl>
        </article>
        <article class="home-info-card home-location-card">
          <p class="home-kicker">Find us in Klang</p>
          <h2>Bandar Bukit Tinggi</h2>
          <address>{runtimeConfig.websiteContent.venue.addressLines.join(", ")}</address>
          <a class="button button-secondary" href={runtimeConfig.websiteContent.venue.mapsUrl}>Get directions <ArrowIcon /></a>
        </article>
      </div>
    </section>

    <section class="home-final-cta" aria-labelledby="final-cta-title">
      <Image src={media.proRig} alt="" widths={[800, 1200]} sizes="(max-width: 560px) 100vw, 88rem" format="webp" loading="lazy" />
      <div class="home-final-copy">
        <p class="home-kicker">Gather your crew</p>
        <h2 id="final-cta-title">Your next <span class="red">lap awaits</span></h2>
        <p>Choose a session and check the next available time.</p>
      </div>
      <a class="button button-primary" href="/book">Book a session <ArrowIcon /></a>
    </section>
  </div>
</BaseLayout>
