---
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/900.css";
import "@fontsource/racing-sans-one/400.css";
import '../styles/race-control.css';
import RaceControlNav from '../components/race-control/RaceControlNav.astro';
import xeromLogo from "@/assets/brand/xerom-logo.svg";
import { env as cloudflareEnv } from "cloudflare:workers";

interface Props { title?: string; section?: string }
const { title = 'Schedule', section = 'schedule' } = Astro.props;
const runtimeEnv = cloudflareEnv as typeof cloudflareEnv & CloudflareEnv;
const liveEnabled = Boolean(runtimeEnv.GOOGLE_SERVICE_ACCOUNT_EMAIL && runtimeEnv.GOOGLE_PRIVATE_KEY && runtimeEnv.BOOKING_COORDINATOR);
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><meta name="theme-color" content="#080808" /><title>{title} · Race Control · Xerom</title><script is:inline>try { if (localStorage.getItem("rc-sidebar") === "collapsed") document.documentElement.classList.add("rc-sidebar-collapsed"); } catch {}</script></head>
  <body class="rc-body">
    <a class="rc-skip" href="#main-content">Skip to main content</a>
    <header class="rc-topbar">
      <a class="rc-brand" href="/race-control/" aria-label="Xerom Race Control home"><img src={xeromLogo.src} alt="Xerom" /></a>
      <div class="rc-top-title"><strong>Race Control</strong><span>Owner front desk</span></div>
      <span class:list={{'rc-sync':true,'rc-sync-demo':!liveEnabled,'rc-sync-live':liveEnabled}}><i aria-hidden="true"></i> {liveEnabled ? 'Live Calendar' : 'Demo data'}</span>
      <button class="rc-icon-button" data-rc-sidebar-toggle type="button" aria-controls="rc-sidebar" aria-expanded="true" aria-label="Collapse section navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" /><path d="M9 4v16" /><path class="rc-sidebar-chevron" d="M14 10l-2 2 2 2" /></svg></button>
      <button class="rc-icon-button" data-rc-refresh type="button" aria-label={liveEnabled ? 'Refresh shared Calendar data' : 'Refresh demo data'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 7v5h-5M5 17v-5h5M18 12a6 6 0 0 0-10.6-3.8L5 10M6 12a6 6 0 0 0 10.6 3.8L19 14" /></svg></button>
      <a class="rc-button rc-button-primary" href="/race-control/schedule#new-booking">New booking</a>
    </header>
    <div class="rc-shell">
      <RaceControlNav active={section} />
      <main class="rc-main" id="main-content">
        <div class="rc-page-heading"><h1>{title}</h1></div>
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  document.querySelector<HTMLButtonElement>("[data-rc-refresh]")?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("race-control:refresh")));

  const sidebarToggle = document.querySelector<HTMLButtonElement>("[data-rc-sidebar-toggle]");
  const root = document.documentElement;
  const syncSidebarToggle = () => {
    const collapsed = root.classList.contains("rc-sidebar-collapsed");
    sidebarToggle?.setAttribute("aria-expanded", String(!collapsed));
    sidebarToggle?.setAttribute("aria-label", collapsed ? "Expand section navigation" : "Collapse section navigation");
  };
  syncSidebarToggle();
  sidebarToggle?.addEventListener("click", () => {
    const collapsed = root.classList.toggle("rc-sidebar-collapsed");
    try { localStorage.setItem("rc-sidebar", collapsed ? "collapsed" : "expanded"); } catch {}
    syncSidebarToggle();
  });
</script>
