---
import { env as cloudflareEnv } from "cloudflare:workers";

interface Props { connected?: boolean }
const { connected = false } = Astro.props;
const runtimeEnv = cloudflareEnv as typeof cloudflareEnv & CloudflareEnv;
const liveEnabled = connected || Boolean(runtimeEnv.GOOGLE_SERVICE_ACCOUNT_EMAIL && runtimeEnv.GOOGLE_PRIVATE_KEY && runtimeEnv.BOOKING_COORDINATOR);
---
<aside class="rc-notice" role="note"><strong>{liveEnabled ? 'Shared Calendar mode' : 'Demo fixture'}</strong><span>{liveEnabled ? 'Schedule reads and owner-created bookings use the same private Google Calendars as the main booking site. Settings publication remains disabled.' : 'Illustrative values only. Nothing on this surface writes to Google Calendar or publishes website changes.'}</span></aside>
