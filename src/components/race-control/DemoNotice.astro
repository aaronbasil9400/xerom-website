---
import { env as cloudflareEnv } from "cloudflare:workers";

interface Props { connected?: boolean }
const { connected = false } = Astro.props;
const runtimeEnv = cloudflareEnv as typeof cloudflareEnv & CloudflareEnv;
const liveEnabled = connected || Boolean(runtimeEnv.GOOGLE_SERVICE_ACCOUNT_EMAIL && runtimeEnv.GOOGLE_PRIVATE_KEY && runtimeEnv.BOOKING_COORDINATOR);
---
<aside class:list={{'rc-notice':true,'rc-notice-live':liveEnabled}} role="note"><strong>{liveEnabled ? 'Shared Calendar mode' : 'Demo fixture'}</strong><span>{liveEnabled ? 'The schedule and bookings use the same private Google Calendars as the public booking site. Settings edits stay private until saved, reviewed and explicitly published.' : 'Illustrative values only. Nothing on this surface writes to Google Calendar or publishes website changes.'}</span></aside>
