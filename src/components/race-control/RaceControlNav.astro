---
interface Props { active: string; live?: boolean }
const { active, live = false } = Astro.props;
const links = [
  { id:'schedule', label:'Schedule', href:'/race-control/schedule' }, { id:'bookings', label:'Bookings', href:'/race-control/bookings' },
  { id:'resources', label:'Experience', href:'/race-control/settings/resources' }, { id:'hours', label:'Hours & Closures', href:'/race-control/settings/hours' },
  { id:'pricing', label:'Pricing', href:'/race-control/settings/pricing' }, { id:'offers', label:'Offers & Packages', href:'/race-control/settings/offers' },
  { id:'rules', label:'Advanced Rules', href:'/race-control/settings/rules' }, { id:'content', label:'Website Content', href:'/race-control/content' },
  { id:'activity', label:'Changes & Activity', href:'/race-control/activity' }, { id:'connection', label:'Connection', href:'/race-control/connection' },
];
---
<nav class="rc-nav" id="rc-sidebar" aria-label="Race Control sections">
  <span class="rc-nav-cue" aria-hidden="true">Swipe for all sections</span>
  <p class="rc-nav-label">Front desk</p>
  {links.slice(0,2).map((link) => <a class:list={{active: active === link.id}} href={link.href} aria-current={active === link.id ? 'page' : undefined}>{link.label}</a>)}
  <p class="rc-nav-label rc-nav-settings">Business settings</p>
  {links.slice(2,7).map((link) => <a class:list={{active: active === link.id}} href={link.href} aria-current={active === link.id ? 'page' : undefined}>{link.label}</a>)}
  <p class="rc-nav-label rc-nav-settings">Publishing</p>
  {links.slice(7).map((link) => <a class:list={{active: active === link.id}} href={link.href} aria-current={active === link.id ? 'page' : undefined}>{link.label}</a>)}
  <p class="rc-nav-foot">Owner-only access<br /><span>{live ? "Shared Calendar live" : "Demo fixture mode"}</span></p>
</nav>
