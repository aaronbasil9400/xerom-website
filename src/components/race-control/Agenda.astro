---
const resources = ['Regular 01','Regular 02','Regular 03','Pro 01','PS5 01','PS5 02'];
const events = [['MOCK GROUP','3–5 PM','Regular 01'],['STAFF HOLD','5–6 PM','Regular 02'],['MOCK CUSTOMER','2–4 PM','Regular 03'],['MOCK GROUP','6–7 PM','Pro 01'],['MOCK FAMILY','4–6 PM','PS5 01'],['MAINTENANCE','2–3 PM','PS5 02']];
const mobileEvents = events.map((event, index) => ({ event, resource: resources[index], startOrder: [15, 17, 14, 18, 16, 14][index] })).sort((left, right) => left.startOrder - right.startOrder || left.resource.localeCompare(right.resource));
---
<section class="rc-panel rc-agenda-panel" aria-labelledby="agenda-title">
  <div class="rc-panel-head"><div><h2 id="agenda-title">Sunday · 13 September 2026</h2><span>MYT · synthetic schedule</span></div><div class="rc-legend"><span class="confirmed">Confirmed</span><span class="blocked">Blocked</span><span class="open">Open</span></div></div>
  <p class="rc-mobile-cue">Agenda view · swipe to inspect the full operating window</p>
  <div class="rc-mobile-agenda-list" aria-label="Synthetic agenda by start time">
    {mobileEvents.map(({ event, resource }) => <article><time>{event[1]}</time><div><strong>{event[0]}</strong><span>{resource} · fixture</span></div><button type="button" aria-label={`Details for ${event[0]}, ${resource}, ${event[1]}`}>Details</button></article>)}
  </div>
  <div class="rc-agenda" aria-label="Demo fixture resource timeline">
    <div class="rc-time-row"><span>Resource</span>{['2 PM','3 PM','4 PM','5 PM','6 PM','7 PM','8 PM','9 PM','10 PM','11 PM','12 AM'].map((t) => <span>{t}</span>)}</div>
    {resources.map((resource, index) => <div class="rc-resource-row"><div class="rc-resource-label"><i class:list={{busy:index===0||index===2||index===4, warning:index===5}}></i><span>{resource}<small>{resource.startsWith('PS5') ? 'play lounge' : resource.startsWith('Pro') ? 'pro sim' : 'sim racing'}</small></span></div><div class="rc-track" aria-label={`${resource} demo fixture events`}><span class="rc-open-track"></span>{events[index] && <button class:list={{'rc-event':true,'rc-event-maintenance':index===5}} type="button" aria-label={`${events[index][0]}, ${resource}, ${events[index][1]}`}><b>{events[index][0]}</b><small>{events[index][1]}</small></button>}</div></div>)}
  </div>
  <p class="rc-panel-foot">All blocks are labelled synthetic fixtures. A future live view must treat every busy Calendar event as unavailable.</p>
</section>
