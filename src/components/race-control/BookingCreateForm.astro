---
import { bookingRules } from "@/config/booking";
import { pricing } from "@/config/pricing";
import { serviceCore } from "@/config/service-core";
---

<section id="new-booking" class="rc-panel rc-booking-form">
  <div class="rc-panel-head"><h2>New booking</h2><span>Manual owner booking · same private Calendar events as the main site</span></div>
  <form data-rc-booking-form>
    <div class="rc-form-grid">
      <label>Start time<input name="start" type="datetime-local" required /><small>Any minute within opening hours; no one-hour notice floor.</small></label>
      <label>Duration<select name="duration">{bookingRules.allowedDurationsMinutes.map((minutes) => <option value={minutes} selected={minutes === 60}>{minutes} minutes</option>)}</select></label>
      <label>Regular rigs<input name="regular" type="number" min="0" max={serviceCore["regular-sim"].capacity} value="1" required /></label>
      <label>Pro rigs<input name="pro" type="number" min="0" max={serviceCore["pro-sim"].capacity} value="0" required /></label>
      <label>PS5 lounges<input name="ps5" type="number" min="0" max={serviceCore.ps5.capacity} value="0" required /></label>
      <label>Additional PS5 controllers<input name="additionalControllers" type="number" min="0" max={pricing.services.ps5.maxAdditionalControllers} value="0" /><small>{pricing.services.ps5.includedControllers} per lounge included; RM{pricing.services.ps5.additionalControllerRate} each per booking.</small></label>
      <label>Customer name<input name="name" minlength="2" maxlength="80" required /></label>
      <label>Mobile / WhatsApp<input name="phone" inputmode="tel" required /></label>
      <label>Email address (optional)<input name="email" type="email" autocomplete="email" maxlength="254" /></label>
      <label class="rc-wide">Notes<textarea name="notes" maxlength="300"></textarea></label>
    </div>
    <div class="rc-form-actions"><button class="rc-button rc-button-primary" type="submit">Create booking</button><output data-rc-booking-result aria-live="polite"></output></div>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-rc-booking-form]");
  const output = document.querySelector<HTMLOutputElement>("[data-rc-booking-result]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!output) return;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    submit?.setAttribute("disabled", "");
    output.className = "";
    output.textContent = "Creating and verifying Calendar events…";
    const values = new FormData(form);
    const localStart = String(values.get("start") ?? "");
    const start = localStart.match(/[zZ]|[+-]\d{2}:\d{2}$/) ? localStart : `${localStart}${localStart.length === 16 ? ":00" : ""}+08:00`;
    const items = [
      { serviceId: "regular-sim", quantity: Number(values.get("regular")) },
      { serviceId: "pro-sim", quantity: Number(values.get("pro")) },
      { serviceId: "ps5", quantity: Number(values.get("ps5")), additionalControllers: Number(values.get("additionalControllers")) },
    ];
    try {
      const response = await fetch("/api/admin/bookings", {
        method: "POST",
        headers: { "content-type": "application/json", "X-Xerom-CSRF": "race-control-v1" },
        body: JSON.stringify({
          start,
          durationMinutes: Number(values.get("duration")),
          items,
          customer: { name: values.get("name"), phone: values.get("phone"), email: values.get("email") || undefined, notes: values.get("notes") || undefined },
          idempotencyKey: crypto.randomUUID(),
        }),
      });
      const result = await response.json() as { bookingId?: string; error?: { message?: string; fieldErrors?: Array<{ path: string; message: string }> } | string };
      if (!response.ok) {
        const error = typeof result.error === "string" ? result.error : result.error?.message ?? "Booking could not be created.";
        const fields = typeof result.error === "object" && result.error?.fieldErrors?.length ? ` ${result.error.fieldErrors.map(({ path, message }) => `${path}: ${message}`).join(" ")}` : "";
        throw new Error(`${error}${fields}`);
      }
      output.className = "rc-output-success";
      output.textContent = `Confirmed ${result.bookingId}. Refreshing the shared Calendar schedule…`;
      window.dispatchEvent(new CustomEvent("race-control:refresh"));
      form.reset();
      document.querySelector<HTMLElement>(".rc-agenda-panel")?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    } catch (error) {
      output.className = "rc-output-error";
      output.textContent = error instanceof Error ? error.message : "Booking could not be created.";
    } finally {
      submit?.removeAttribute("disabled");
    }
  });
</script>
