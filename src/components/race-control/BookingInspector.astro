---
import { NO_SHOW_GRACE_MINUTES } from "@/lib/race-control/no-show";
interface Props { live?: boolean }
const { live = false } = Astro.props;
---
<aside class="rc-inspector rc-panel" aria-labelledby="selected-booking">
  <div class="rc-panel-head"><h2 id="selected-booking">{live ? 'Select a live booking' : 'Mock group booking · selected fixture'}</h2><button class="rc-close" type="button" aria-label="Close booking details"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div>
  {live ? <div class="rc-inspector-body" data-rc-live-inspector>
    <div class="rc-empty" data-rc-live-empty><h2>Live inspector ready</h2><p>Choose a booking block from the live Calendar read to inspect its status, resource, timing and available actions.</p></div>
    <dl data-rc-live-details hidden>
      <div><dt>Booking ID</dt><dd class="rc-mono" data-live-booking-id>—</dd></div>
      <div><dt>Status</dt><dd><span class="rc-status" data-live-status>—</span></dd></div>
      <div><dt>When</dt><dd data-live-when>—</dd></div>
      <div><dt>Resource</dt><dd data-live-resource>—</dd></div>
      <div><dt>Customer</dt><dd data-live-customer>—</dd></div>
      <div><dt>Phone</dt><dd><a data-live-phone>—</a></dd></div>
      <div data-live-email-row><dt>Email</dt><dd><a data-live-email>—</a></dd></div>
      <div><dt>Duration</dt><dd data-live-duration>—</dd></div>
      <div data-live-controller-row><dt>Controllers</dt><dd data-live-controllers>—</dd></div>
      <div><dt>Calendar event</dt><dd data-live-summary>—</dd></div>
    </dl>
    <a class="rc-button rc-button-primary rc-whatsapp-customer" data-live-whatsapp hidden target="_blank" rel="noopener noreferrer">WhatsApp customer</a>
    <div class="rc-live-actions" data-rc-live-actions hidden>
      <p>Actions update every linked Calendar event conditionally.</p>
      <p>No-show is available after the {NO_SHOW_GRACE_MINUTES}-minute late-arrival grace period.</p>
      <label><input type="checkbox" data-live-release /> Release remaining time when completing</label>
      <div class="rc-live-action-buttons">
        <button class="rc-button rc-button-small" type="button" data-live-action="check-in">Check in</button>
        <button class="rc-button rc-button-small" type="button" data-live-action="complete">Complete</button>
        <button class="rc-button rc-button-small" type="button" data-live-action="no-show">No-show</button>
        <button class="rc-button rc-button-small" type="button" data-live-action="cancel">Cancel</button>
      </div>
      <output data-live-action-result aria-live="polite"></output>
    </div>
    <div class="rc-note" data-rc-live-note hidden><strong>Calendar is authoritative</strong><p>Lifecycle actions remain conditional on the latest grouped Calendar version.</p></div>
  </div> : <div class="rc-inspector-body"><dl><div><dt>Booking ID</dt><dd class="rc-mono">XR-DEMO-42</dd></div><div><dt>Status</dt><dd><span class="rc-status">Confirmed · fixture</span></dd></div><div><dt>When</dt><dd>Sun, 13 Sep · 6–7 PM MYT</dd></div><div><dt>Resources</dt><dd><span class="rc-chip">Regular 01</span> <span class="rc-chip">Pro 01</span></dd></div><div><dt>Customer</dt><dd>Demo customer · synthetic</dd></div></dl><button class="rc-button rc-button-primary" type="button">View actions (demo)</button><button class="rc-button" type="button">Copy fixture ID</button><div class="rc-note"><strong>Calendar is authoritative</strong><p>Live mutation actions will be enabled only after owner authentication and contract-backed Calendar reads.</p></div></div>}
</aside>

{live && <script>
  import { normalizeMalaysianMobile } from "@/lib/booking/phone";
  import { NO_SHOW_GRACE_MINUTES } from "@/lib/race-control/no-show";
  type BookingDetails = { customerName: string; customerPhone: string; customerEmail?: string; durationMinutes: number; includedControllers: number; additionalControllers: number; totalControllers: number; priceTotal: number | null; createdAt: string | null };
  type SelectedEvent = { bookingId: string | null; version: number; status: string; summary: string; resourceName: string; serviceId: string; start: string; end: string; bookingDetails: BookingDetails };
  const inspectorHeading = document.querySelector<HTMLElement>("#selected-booking");
  const inspectorEmpty = document.querySelector<HTMLElement>("[data-rc-live-empty]");
  const inspectorDetails = document.querySelector<HTMLElement>("[data-rc-live-details]");
  const inspectorNote = document.querySelector<HTMLElement>("[data-rc-live-note]");
  const inspectorActions = document.querySelector<HTMLElement>("[data-rc-live-actions]");
  const releaseInput = document.querySelector<HTMLInputElement>("[data-live-release]");
  const actionResult = document.querySelector<HTMLOutputElement>("[data-live-action-result]");
  const whatsappLink = document.querySelector<HTMLAnchorElement>("[data-live-whatsapp]");
  const emailRow = document.querySelector<HTMLElement>("[data-live-email-row]");
  const controllerRow = document.querySelector<HTMLElement>("[data-live-controller-row]");
  let selectedEvent: SelectedEvent | null = null;
  let noShowTimer: number | undefined;
  const clearInspector = () => {
    if (noShowTimer !== undefined) window.clearTimeout(noShowTimer);
    noShowTimer = undefined;
    selectedEvent = null;
    if (inspectorHeading) inspectorHeading.textContent = "Select a live booking";
    if (inspectorEmpty) inspectorEmpty.hidden = false;
    if (inspectorDetails) inspectorDetails.hidden = true;
    if (inspectorActions) inspectorActions.hidden = true;
    if (inspectorNote) inspectorNote.hidden = true;
    if (actionResult) actionResult.textContent = "";
    if (whatsappLink) whatsappLink.hidden = true;
  };
  const setInspectorValue = (selector: string, value: string) => { const target = document.querySelector<HTMLElement>(selector); if (target) target.textContent = value; };
  const formatInspectorWhen = (start: string, end: string) => {
    const formatter = new Intl.DateTimeFormat("en-MY", { timeZone: "Asia/Kuala_Lumpur", dateStyle: "medium", timeStyle: "short" });
    return `${formatter.format(new Date(start))}–${formatter.format(new Date(end))}`;
  };
  const formatDuration = (minutes: number) => minutes === 30 ? "30 minutes" : minutes === 60 ? "1 hour" : minutes === 90 ? "1 hour 30 minutes" : minutes === 120 ? "2 hours" : `${minutes} minutes`;
  const syncActionVisibility = () => {
    const currentSelection = selectedEvent;
    if (!inspectorActions || !currentSelection) return;
    if (noShowTimer !== undefined) window.clearTimeout(noShowTimer);
    noShowTimer = undefined;
    const status = currentSelection.status.toLowerCase();
    const isActive = status === "confirmed" || status === "checked_in";
    inspectorActions.hidden = !currentSelection.bookingId || currentSelection.version < 0 || !isActive;
    inspectorActions.querySelectorAll<HTMLButtonElement>("[data-live-action]").forEach((button) => {
      const action = button.dataset.liveAction;
      button.hidden = action === "check-in" ? status !== "confirmed" : action === "complete" ? status !== "checked_in" : action === "no-show" ? status !== "confirmed" : action === "cancel" ? status !== "confirmed" && status !== "checked_in" : true;
      if (action === "no-show" && !button.hidden) {
        const parsedStart = Date.parse(currentSelection.start);
        const availableAt = Number.isFinite(parsedStart) ? parsedStart + NO_SHOW_GRACE_MINUTES * 60_000 : Number.POSITIVE_INFINITY;
        const wait = availableAt - Date.now();
        button.disabled = wait > 0;
        button.title = wait > 0 ? `Available after the ${NO_SHOW_GRACE_MINUTES}-minute grace period.` : "";
        if (wait > 0) noShowTimer = window.setTimeout(syncActionVisibility, wait + 50);
      }
    });
  };
  window.addEventListener("race-control:select-event", (event) => {
    selectedEvent = (event as CustomEvent<SelectedEvent>).detail;
    if (!selectedEvent) return;
    if (inspectorHeading) inspectorHeading.textContent = selectedEvent.bookingId ? "Live booking" : "Live Calendar block";
    if (inspectorEmpty) inspectorEmpty.hidden = true;
    if (inspectorDetails) inspectorDetails.hidden = false;
    if (inspectorNote) inspectorNote.hidden = false;
    if (actionResult) actionResult.textContent = "";
    setInspectorValue("[data-live-booking-id]", selectedEvent.bookingId ?? "Calendar block");
    setInspectorValue("[data-live-status]", selectedEvent.status);
    setInspectorValue("[data-live-when]", formatInspectorWhen(selectedEvent.start, selectedEvent.end));
    setInspectorValue("[data-live-resource]", selectedEvent.resourceName);
    setInspectorValue("[data-live-summary]", selectedEvent.summary);
    setInspectorValue("[data-live-customer]", selectedEvent.bookingDetails.customerName || "Not stored");
    setInspectorValue("[data-live-duration]", formatDuration(selectedEvent.bookingDetails.durationMinutes));
    const phone = document.querySelector<HTMLAnchorElement>("[data-live-phone]");
    if (phone) { phone.textContent = selectedEvent.bookingDetails.customerPhone || "Not stored"; phone.removeAttribute("href"); if (selectedEvent.bookingDetails.customerPhone) phone.href = `tel:${selectedEvent.bookingDetails.customerPhone}`; }
    const email = document.querySelector<HTMLAnchorElement>("[data-live-email]");
    if (emailRow) emailRow.hidden = !selectedEvent.bookingDetails.customerEmail;
    if (email && selectedEvent.bookingDetails.customerEmail) { email.textContent = selectedEvent.bookingDetails.customerEmail; email.href = `mailto:${selectedEvent.bookingDetails.customerEmail}`; }
    if (controllerRow) controllerRow.hidden = selectedEvent.serviceId !== "ps5";
    if (selectedEvent.serviceId === "ps5") setInspectorValue("[data-live-controllers]", `${selectedEvent.bookingDetails.includedControllers} included + ${selectedEvent.bookingDetails.additionalControllers} additional = ${selectedEvent.bookingDetails.totalControllers} total`);
    const normalizedPhone = normalizeMalaysianMobile(selectedEvent.bookingDetails.customerPhone);
    if (whatsappLink) {
      whatsappLink.hidden = !selectedEvent.bookingId || !normalizedPhone;
      if (selectedEvent.bookingId && normalizedPhone) whatsappLink.href = `https://wa.me/${normalizedPhone.slice(1)}?text=${encodeURIComponent(`Hi ${selectedEvent.bookingDetails.customerName || "there"}, this is Xerom regarding booking ${selectedEvent.bookingId}.`)}`;
    }
    syncActionVisibility();
  });
  window.addEventListener("race-control:selection-clear", clearInspector);
  inspectorActions?.querySelectorAll<HTMLButtonElement>("[data-live-action]").forEach((button) => button.addEventListener("click", async () => {
    if (!selectedEvent?.bookingId) return;
    const action = button.dataset.liveAction;
    if (!action || !["check-in", "complete", "no-show", "cancel"].includes(action)) return;
    if (!window.confirm(`${action === "cancel" ? "Cancel" : action === "no-show" ? "Mark no-show" : action === "check-in" ? "Check in" : "Complete"} booking ${selectedEvent.bookingId}?`)) return;
    const reason = action === "cancel" || action === "no-show" ? window.prompt(`${action === "cancel" ? "Cancellation" : "No-show"} reason`) : undefined;
    if ((action === "cancel" || action === "no-show") && !reason?.trim()) return;
    inspectorActions.querySelectorAll<HTMLButtonElement>("[data-live-action]").forEach((item) => { item.disabled = true; });
    if (actionResult) actionResult.textContent = "Updating and verifying Calendar events…";
    const actionPayload = action === "check-in" ? { action, expected: { bookingId: selectedEvent.bookingId, version: selectedEvent.version } } : action === "complete" ? { action, expected: { bookingId: selectedEvent.bookingId, version: selectedEvent.version }, releaseRemainingTime: Boolean(releaseInput?.checked) } : { action, expected: { bookingId: selectedEvent.bookingId, version: selectedEvent.version }, reason: reason!.trim() };
    try {
      const response = await fetch(`/api/admin/bookings/${encodeURIComponent(selectedEvent.bookingId)}/actions`, { method: "POST", headers: { "content-type": "application/json", "X-Xerom-CSRF": "race-control-v1" }, body: JSON.stringify({ action: actionPayload, idempotencyKey: crypto.randomUUID() }) });
      const payload = await response.json() as { status?: string; version?: number; error?: { message?: string } | string };
      if (!response.ok) throw new Error(typeof payload.error === "string" ? payload.error : payload.error?.message ?? "The booking action could not be completed.");
      selectedEvent = { ...selectedEvent, status: payload.status ?? selectedEvent.status, version: payload.version ?? selectedEvent.version + 1 };
      setInspectorValue("[data-live-status]", selectedEvent.status);
      if (actionResult) actionResult.textContent = `Booking ${selectedEvent.bookingId} is ${selectedEvent.status}. Refreshing the shared schedule…`;
      syncActionVisibility();
      window.dispatchEvent(new CustomEvent("race-control:refresh"));
    } catch (error) {
      if (actionResult) actionResult.textContent = error instanceof Error ? error.message : "The booking action could not be completed.";
    } finally {
      inspectorActions.querySelectorAll<HTMLButtonElement>("[data-live-action]").forEach((item) => { item.disabled = false; });
    }
  }));
</script>}
