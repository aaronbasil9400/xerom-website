---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  hero: ImageMetadata;
  heroAlt: string;
  secondary: ImageMetadata;
  secondaryAlt: string;
}

const { title, description, hero, heroAlt, secondary, secondaryAlt } = Astro.props;
---

<BaseLayout title={`${title} | Xerom SimRacing & Cafe`} description={description}>
  <article class="placeholder-page section-shell">
    <header class="placeholder-hero">
      <Image src={hero} alt={heroAlt} widths={[800, 1200]} sizes="(max-width: 900px) 100vw, 88rem" format="webp" />
      <div>
        <p class="placeholder-status">Temporary page · owner content pending</p>
        <h1 class="display">{title}</h1>
      </div>
    </header>
    <section class="placeholder-copy" aria-label={`${title} placeholder content`}>
      <div>
        <h2>More details are on the way</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. This temporary copy marks the content area that will be replaced with owner-approved information.</p>
        <p>Lorem ipsum dolor sit amet, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      </div>
      <Image src={secondary} alt={secondaryAlt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, 40vw" format="webp" loading="lazy" />
    </section>
  </article>
</BaseLayout>
