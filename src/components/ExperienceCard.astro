---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArrowIcon from "./ArrowIcon.astro";
interface Props {
  title: string;
  copy: string;
  image: ImageMetadata;
  alt: string;
  price?: string;
  href: string;
}
const { title, copy, image, alt, price, href } = Astro.props;
---
<article class="experience-card">
  <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 560px) 38vw, (max-width: 900px) 50vw, 25vw" format="webp" loading="lazy" />
  <div class="experience-body">
    <div>
      <h3>{title}</h3>
      {price && <span class="price">{price}</span>}
    </div>
    <a class="round-link" href={href} aria-label={`Explore ${title}`}><ArrowIcon /></a>
    <p>{copy}</p>
  </div>
</article>
