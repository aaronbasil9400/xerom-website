---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ArrowIcon from "@/components/ArrowIcon.astro";

interface Props {
  title: string;
  copy: string;
  image: ImageMetadata;
  alt: string;
  price?: string;
  suffix?: string;
  href: string;
  featured?: boolean;
}

const { title, copy, image, alt, price, suffix = "/ hour", href, featured = false } = Astro.props;
---

<article class:list={["home-session-card", { "home-session-card-featured": featured }]} data-session-card>
  <a class="home-session-link" href={href} aria-label={`${title}: ${price ? `${price} per hour. ` : ""}${copy}`}>
    <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 560px) 44vw, (max-width: 1024px) 50vw, 25vw" format="webp" loading="lazy" />
    <span class="home-session-scrim" aria-hidden="true"></span>
    <span class="home-session-content">
      <span class="home-session-title">{title}</span>
      {price ? <span class="home-session-price"><strong>{price}</strong> <small>{suffix}</small></span> : <span class="home-session-price"><strong>Food & drinks</strong></span>}
      <span class="home-session-copy">{copy}</span>
    </span>
    <span class="home-session-arrow" aria-hidden="true"><ArrowIcon /></span>
  </a>
</article>
