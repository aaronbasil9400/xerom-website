---
import { Image, Picture } from "astro:assets";
import { media } from "@/config/media";

const tiles = [
  { label: "Sim racing", image: media.regularRig, alt: "Close-up of the Fanatec control on Xerom’s Regular Rig", className: "gallery-race", placeholder: false },
  { label: "PS5 gaming", image: media.ps5Lounge, alt: "Two PS5 controllers ready in front of the Xerom lounge screen", className: "gallery-play", placeholder: false },
  { label: "Race together", image: media.hero, alt: "Illustrative placeholder showing friends enjoying sim racing; replace with approved Xerom photography", className: "gallery-group", placeholder: true },
  { label: "Cafe break", image: media.cafe, alt: "Three colourful drinks from the Xerom cafe", className: "gallery-cafe", placeholder: false },
] as const;
---

<div class="venue-gallery" data-venue-gallery>
  {tiles.map((tile) => (
    <figure class:list={["venue-tile", tile.className]}>
      {tile.placeholder ? (
        <Picture src={tile.image} alt={tile.alt} widths={[640, 960]} sizes="(max-width: 560px) 50vw, 34vw" formats={["avif", "webp"]} fallbackFormat="jpg" loading="lazy" />
      ) : (
        <Image src={tile.image} alt={tile.alt} widths={[480, 800, 1200]} sizes="(max-width: 560px) 50vw, 34vw" format="webp" loading="lazy" />
      )}
      <figcaption><span>{tile.label}</span>{tile.placeholder && <small>Illustrative placeholder</small>}</figcaption>
    </figure>
  ))}
</div>
